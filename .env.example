# Copy this file to .env and fill in ONE block. Paradox talks to any OpenAI-compatible endpoint.
# Your .env stays on your machine; it is in .gitignore and never committed.

# --- Local, free, private: Ollama (the default if you set nothing) ---
PARADOX_LLM_URL=http://localhost:11434/v1
PARADOX_LLM_MODEL=qwen2.5:7b-instruct
PARADOX_LLM_KEY=ollama

# --- Groq (free tier) ---
# PARADOX_LLM_URL=https://api.groq.com/openai/v1
# PARADOX_LLM_MODEL=qwen/qwen3.8-27b
# PARADOX_LLM_KEY=gsk_your_key_here

# --- Google Gemini (free tier) ---
# PARADOX_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PARADOX_LLM_MODEL=gemini-3.1-flash-lite
# PARADOX_LLM_KEY=your_google_ai_studio_key

# --- OpenAI ---
# PARADOX_LLM_URL=https://api.openai.com/v1
# PARADOX_LLM_MODEL=a model name from platform.openai.com/docs/models
# PARADOX_LLM_KEY=sk-your_key_here

# --- LM Studio (local) ---
# PARADOX_LLM_URL=http://localhost:1234/v1
# PARADOX_LLM_MODEL=the-model-name-shown-in-lm-studio
# PARADOX_LLM_KEY=lm-studio

